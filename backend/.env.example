# Application
APP_NAME=meeting-intelligence-api
ENVIRONMENT=local

# Logging
LOG_LEVEL=INFO
# true  -> single-line JSON (production / docker)
# false -> coloured console output (local development)
LOG_JSON=true

# CORS: JSON array of allowed frontend origins
CORS_ORIGINS=["http://localhost:3000"]

# Retrieval
# Local ONNX embedding model; downloaded once on first ingestion.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Soft character budget per retrieval chunk.
CHUNK_TARGET_CHARS=700

# Answer generation
# Required only for generating answers; ingestion and retrieval work without it.
# Never commit a real key.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
LLM_TIMEOUT_SECONDS=30

# Audio transcription
# Required only for POST /api/transcriptions. Never commit a real key.
OPENAI_API_KEY=
# whisper-1 is the only model that reports language and duration.
OPENAI_TRANSCRIPTION_MODEL=whisper-1
MAX_AUDIO_UPLOAD_MB=25
