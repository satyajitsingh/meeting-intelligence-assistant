# Application
APP_NAME=meeting-intelligence-api
ENVIRONMENT=local

# Logging
LOG_LEVEL=INFO
# true  -> single-line JSON (production / docker)
# false -> coloured console output (local development)
LOG_JSON=true

# CORS: JSON array of allowed frontend origins
CORS_ORIGINS=["http://localhost:3000"]

# Provider credentials are introduced in later phases:
#   ANTHROPIC_API_KEY=sk-ant-...   (Phase 7, LLM answers)
